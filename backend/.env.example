APP_NAME="REEN Money"
APP_ENV=local
APP_KEY=base64:YOUR_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reen_money
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@reenm oney.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_URLS=false

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
SANCTUM_GUARD=sanctum

# Fintech Configuration
FINTECH_CURRENCY=XAF
FINTECH_COUNTRY=CM
FINTECH_TIMEZONE=Africa/Douala

# KYC Configuration
KYC_LEVEL_1_LIMIT=50000
KYC_LEVEL_2_LIMIT=500000
KYC_LEVEL_3_LIMIT=2000000

# Transaction Limits by Role
TRANSACTION_LIMIT_L1=999999999
TRANSACTION_LIMIT_L2=500000
TRANSACTION_LIMIT_L3=100000
TRANSACTION_LIMIT_L4=50000
TRANSACTION_LIMIT_L5=10000

# 2FA Configuration
2FA_REQUIRED=true
2FA_ALGORITHM=totp

# Audit Configuration
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_IMMUTABLE=true

# Fraud Detection
FRAUD_CHECK_ENABLED=true
FRAUD_RISK_THRESHOLD=50
